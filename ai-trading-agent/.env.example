# ============================================================
# OpenClaw Trading Agent — Configuration Template
# ============================================================
# Bu faylni `.env` deb nusxa oling va o'zingizning qiymatlaringiz
# bilan to'ldiring. `.env` git'ga commit qilinmaydi (.gitignore).
#
# Pydantic v2 strict validation: noto'g'ri qiymat (masalan
# RISK_PER_TRADE=abc yoki DAILY_MAX_RISK=100) bot startupda
# ValidationError beradi. Chegaralar config.py'da ko'rsatilgan.
# ============================================================

# ── MetaTrader 5 (MAJBURIY) ──────────────────────────────────
# Demo akkount: https://www.exness.com (Trial server)
# Live'ga o'tishdan oldin 30 kun demo + 60% win rate (CLAUDE.md)
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=Exness-MT5Trial7

# ── T-02: Execution mode (xavfsizlik kaliti) ─────────────────
# 'demo' (default) yoki 'live'. REAL MT5 account (trade_mode=Real)
# bilan ulanish/savdo faqat 'live' bo'lsa ruxsat etiladi; aks holda
# bot ulanishni RAD etadi. Demo/trial serverlar uchun 'demo'.
EXECUTION_MODE=demo             # [demo|live]

# ── Trading instrument ────────────────────────────────────────
SYMBOL=XAUUSD
SCAN_INTERVAL=30                # soniya, [1..600]

# ── Risk parametrlari ─────────────────────────────────────────
# DIQQAT: bu qiymatlar haqiqiy puldagi maksimal yo'qotishni
# belgilaydi. F1-2 strict validation chegaralarni majburlaydi.
RISK_PER_TRADE=1.0              # % per trade,           [0..5.0]
DAILY_MAX_RISK=5.0              # % daily loss breaker,  [0..10.0]
DAILY_PROFIT_TARGET=10.0        # % daily profit stop,   [0..50.0]
MAX_DRAWDOWN=10.0               # % session DD breaker,  [0..50.0]
MAX_POSITIONS=2                 # parallel trades,       [1..10]
MAX_TRADES_PER_DAY=25           # kuniga limit,          [1..100]
MAX_LOT_CAP=0.0                 # per-order lot cap, 0=off [0..500]; sizing/BE/AI'dan keyin clamp

# ── Market-near-zone entry (limit o'rniga darhol market) ──────
# Joriy narx zona entry'siga shu pip-masofa ICHIDA bo'lsa, bot pending
# limit qo'yish o'rniga DARHOL market bilan kiradi (narx zonaga deyarli
# yetgan). 0.0 = o'chiq (faqat limit). 5.0 = tavsiya (XAUUSD 5 pip = $0.50).
MARKET_NEAR_PIPS=5.0            # pip, [0..50]; 0=off

# Invariants (TradingConfig @model_validator tekshiradi):
#   • DAILY_MAX_RISK >= RISK_PER_TRADE
#   • MAX_DRAWDOWN   >= DAILY_MAX_RISK

# ── F5-3: High-vol regime gate (yomon-davr himoyasi) ──────────
# M15 ATR% (ATR/price*100) shu chegaradan oshsa, mo'rt reversion
# setuplar (M15_OB/BB/CISD) bloklanadi. 2025-Q2 (yuqori-vol trend)
# halokati uchun himoya. 0.0 = o'chiq; 0.18 = production calibrated.
REGIME_ATR_THRESHOLD=0.0       # ATR% chegara, [0..5.0]; jonlida 0.18
REGIME_ATR_PERIOD=14           # ATR lookback (SMA),     [1..200]

# ── F5-4: Setup block list ────────────────────────────────────
# Bu setup label'lari regime'dan qat'i nazar umuman savdo qilinmaydi
# (vergul bilan ajratiladi). Bo'sh = hech narsa bloklanmaydi.
# Misol: BLOCKED_SETUPS=M15_OB,H1_OB
BLOCKED_SETUPS=

# ── AI Brain (Claude API) ─────────────────────────────────────
# https://console.anthropic.com — bo'sh qoldirsangiz AI off,
# self-learner faqat statistika bilan ishlaydi.
CLAUDE_API_KEY=
MIN_AI_CONFIDENCE=0.70          # min trade confidence,  [0.0..1.0]

# ── Telegram bot (ixtiyoriy) ──────────────────────────────────
# Notify off bo'lishi uchun bo'sh qoldiring.
# BotFather'dan token oling: https://t.me/BotFather
# Chat ID: @userinfobot ga "/start" yuboring.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Self-learner (F1-1 admin approval gate) ───────────────────
# false (default) → analyze()/evolve() taklif qiladi, learned.json
#   o'zgartirilmaydi. Admin `python -m apps.api.src.tools.admin_cli
#   approve <id>` orqali tasdiqlaydi.
# true → eski xulq: parametr o'zgarishi avtomatik qo'llaniladi
#   (faqat AI brain validatsiyasiga ishonsangiz).
AUTO_APPLY_LEARNING=false

# ── Database / Socket (hozircha ishlatilmaydi) ────────────────
# Postgres va Redis docker-compose.yml'da bor, lekin kod hozir
# JSON fayllar bilan ishlaydi. Kelajakda (F4+) faollashadi.
DATABASE_URL=postgresql://trader:password@localhost:5432/openclaw
REDIS_URL=redis://localhost:6379
SOCKET_URL=http://localhost:8000

# ── Test-only overrides (production'da QO'YMANG) ──────────────
# Bu o'zgaruvchilar test scriptlari uchun mo'ljallangan, ularni
# `.env` ga qo'shish testning real ma'lumotlarga ta'sirini
# keltirib chiqaradi.
#
# OPENCLAW_STATE_DIR=/path/to/temp/state  # db.py + admin_cli yo'lini override
# OPENCLAW_LEARNED_JSON=/path/learned.json # admin_cli faqat
# NO_COLOR=1                              # admin_cli ANSI ranglarni o'chiradi

# ─── Credentials va sirlar (KRITIK) ────────────────────────────────
.env
.env.local
.env.*.local
*.env
# 2026-08-03: `.env` ni tahrirlashdan oldin backup olinadi
# (`.env.bak-YYYY-MM-DD`), lekin yuqoridagi naqshlarning BIRORTASI uni
# tutmasdi — parol, Claude API kaliti va Telegram tokeni git'ga tushib
# ketishi mumkin edi. Quyidagi qator har qanday `.env.<nimadir>` ni yopadi.
.env.*
!.env.example

# Jonli fayllarni tahrirlashdan oldin olinadigan backuplar
# (trades.csv.bak-…, trade_meta.json.bak-…, .env.bak-…). Git'ning o'zi
# tarixni saqlaydi — backup nusxalari repo'ga kerak emas va ular
# ba'zan sir yoki moliyaviy yozuv nusxasini olib yuradi.
*.bak-*
**/credentials.json
**/secrets.json
*.pem
*.key

# ─── Claude Code session fayllari ──────────────────────────────────
.claude/

# ─── Python ────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/
*.egg

# ─── Virtual env ───────────────────────────────────────────────────
venv/
.venv/
env/

# ─── F0-1: Runtime state (har tick'da yoziladi, history shart emas) ─
data/state/
apps/data/state/
ai-trading-agent/data/state/
ai-trading-agent/apps/data/state/
.trade_meta_*.json

# ─── F2-3: Historical market data (MT5'dan qayta yuklab olinadi) ────
data/historical/
ai-trading-agent/data/historical/

# ─── F2-3: Backtest output (har run'da yangi UUID fayllari) ─────────
reports/*
ai-trading-agent/reports/*
# Qo'lda yozilgan acceptance/audit hisobotlari va .gitkeep — saqlanadi
!reports/.gitkeep
!ai-trading-agent/reports/.gitkeep
!ai-trading-agent/reports/f2-*.md
!ai-trading-agent/reports/*_acceptance_*.md

# ─── IDE ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ─── Logs ─────────────────────────────────────────────────────────
*.log
logs/

# ─── OS ───────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
